# ---- Which provider serves what -------------------------------------------
# openai | azure   (chat script generation)
LLM_PROVIDER=openai
# openai | azure | azure_speech   (text to speech)
TTS_PROVIDER=openai

# ---- OpenAI ----------------------------------------------------------------
# You already have a key in ~/dev/ragged/.env
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Azure AI Foundry / Azure OpenAI ---------------------------------------
# Endpoint of the Foundry project resource, e.g. https://my-proj.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names, not model names
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_TTS_DEPLOYMENT=
# TTS on Azure needs a preview api-version; leave blank to reuse the one above
AZURE_OPENAI_TTS_API_VERSION=2025-03-01-preview

# ---- Voices ----------------------------------------------------------------
# Audition them at http://localhost:8077/voices
# alloy ash ballad coral echo fable nova onyx sage shimmer verse
HOST_VOICE=nova
GUEST_VOICE=ash
# How each voice is told to perform. Blank uses the (lively) defaults in config.py.
HOST_STYLE=
GUEST_STYLE=

# ---- GitLab ----------------------------------------------------------------
# Defaults are read from ~/.config/glab-cli/config.yml when left blank
GITLAB_HOST=
GITLAB_TOKEN=

# ---- Tuning ----------------------------------------------------------------
# Max diff characters handed to the model in one pass
MAX_DIFF_CHARS=90000

# ---- Azure AI Speech (TTS_PROVIDER=azure_speech) ----------------------------
# Served by any AIServices resource; no model deployment needed.
AZURE_SPEECH_REGION=swedencentral
# blank reuses AZURE_OPENAI_API_KEY when it is the same resource
AZURE_SPEECH_KEY=
# Voice names from https://<region>.tts.speech.microsoft.com/cognitiveservices/voices/list
AZURE_SPEECH_HOST_VOICE=en-US-AriaNeural
AZURE_SPEECH_GUEST_VOICE=en-US-DavisNeural
# Direction as SSML directives; style must be in that voice's StyleList
AZURE_SPEECH_HOST_STYLE=style=chat;degree=1.4;rate=+8%
AZURE_SPEECH_GUEST_STYLE=style=excited;degree=1.7;rate=+10%;pitch=+2st
